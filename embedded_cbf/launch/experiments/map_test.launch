<launch>

    <arg name="x_0"  default="0.0" />
    <arg name="y_0"  default="0.0" />
    <arg name="psi"  default="0.0" />

    <arg name="N_cbf"         default="38"/>
    <arg name="safety_margin" default="0.0" />

    <include file="$(find gazebo_sim)/launch/gazebo_roboat.launch">
        <arg name="x_0"  value="$(arg x_0)" />
        <arg name="y_0"  value="$(arg y_0)" />
        <arg name="psi"  value="$(arg psi)" />
    </include>

    <include file="$(find roboat_planning)/launch/global_planner.launch" />

    <node name="firi_node" pkg="firi_ros" type="firi_grid_node" />

    <include file="$(find embedded_cbf)/launch/mpc_cbf_path.launch">
        <arg name="N_cbf"         value="$(arg N_cbf)"/>
        <!-- <arg name="safety_margin" value="$(arg safety_margin)"/> -->
    </include>

</launch>