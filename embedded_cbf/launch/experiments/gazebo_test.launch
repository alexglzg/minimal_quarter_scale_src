<launch>

    <arg name="x_0"  default="0.0" />
    <arg name="y_0"  default="0.1" />
    <arg name="psi"  default="0.15" />

    <include file="$(find gazebo_sim)/launch/spawn_intersection.launch" />

    <include file="$(find gazebo_sim)/launch/gazebo_roboat.launch">
        <arg name="x_0"  value="$(arg x_0)" />
        <arg name="y_0"  value="$(arg y_0)" />
        <arg name="psi"  value="$(arg psi)" />
    </include>

    <include file="$(find obstacle_detector)/launch/pcl_filter.launch" />

    <include file="$(find roboat_planning)/launch/run_boat.launch" />

    <node name="firi_node" pkg="firi_ros" type="firi_node" />

</launch>