<launch>

    <arg name="x_0"  default="0.65" />
    <arg name="y_0"  default="0.45" />
    <arg name="psi"  default="0.15" />

    <include file="$(find embedded_cbf)/launch/experiments/gazebo_test.launch">
        <arg name="x_0"  value="$(arg x_0)" />
        <arg name="y_0"  value="$(arg y_0)" />
        <arg name="psi"  value="$(arg psi)" />
    </include>

    <include file="$(find gazebo_sim)/launch/iros2026_scenarios/iros26_8.launch" />

</launch>