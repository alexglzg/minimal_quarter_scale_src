<launch>

    <!-- Wind and waves simulation -->

    <node name="wind_and_waves" type="wind_and_waves" pkg="quarterscalesimulation" >
    <param name = "beta_wave" value = "0.0" />
    <param name = "stddev_wF" value = "1.0" />
    <param name = "stddev_dF" value = "0.5" />
    <param name = "stddev_wN" value = "0.1" />
    <param name = "stddev_dN" value = "0.05" />
    <param name = "beta_wind" value = "0.0" />
    <param name = "V_wind_knots" value = "3.98" /> <!-- ~2.05 m/s, previous default -->
    <param name = "scale_factor_wind" value = "1.0" />
    <param name = "scale_factor_wave" value = "1.0" />
    <param name = "buoy_stddev_dF" value = "0.05" />
    <param name = "buoy_dF_min" value = "-2.0" />
    <param name = "buoy_dF_max" value = "2.0" />
    <param name = "buoy_CD" value = "0.5" />
    </node>

</launch>