{
	"name": "ros1_noetic_dev",
	"build": {
	  "dockerfile": "../Dockerfile",
	  "context": ".."
	},
	"runArgs": [
	  "--net=host",
	  "--privileged",
	  "-e", "DISPLAY=${env:DISPLAY}",
	  "-e", "QT_X11_NO_MITSHM=1",
	  "--device=/dev/dri:/dev/dri",
	  "--gpus", "all",
	  "-v", "/tmp/.X11-unix:/tmp/.X11-unix:rw"
	],
	"workspaceFolder": "/ros1_ws/src",
	"mounts": [
	  "source=${localWorkspaceFolder},target=/ros1_ws/src,type=bind,consistency=cached"
	],
	"remoteUser": "root"
  }
  
