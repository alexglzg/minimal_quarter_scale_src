<launch>
  <node pkg="obstacle_detector" type="buoy_simulator.py" name="buoy_sim" output="screen">
    <rosparam param="buoys">
      - name: buoy1
        radius: 0.7
        mass: 200.0
        initial_state: [4.0, 0.2, 0.0, 0.0, 0.0, 0.0]
      - name: buoy2
        radius: 0.7
        mass: 200.0
        initial_state: [10.0, 0.2, 0.0, 0.0, 0.0, 0.0]
      - name: buoy3
        radius: 0.7
        mass: 200.0
        initial_state: [10.0, -2.2, 0.0, 0.0, 0.0, 0.0]
    </rosparam>
  </node>
</launch>
