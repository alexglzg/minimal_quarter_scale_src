<launch>
    <!-- Load path/model parameters (global for simplicity) -->
    <rosparam file="$(find control)/config/parameters.yaml" command="load" />

    <!-- Amortized-NMPC-alpha controller node (drop anmpc_alpha/model.eqx +
         model_meta.yaml into control/scripts/anmpc_alpha/ before running this) -->
    <node pkg="control"
          type="anmpc_alpha_node.py"
          name="anmpc_alpha_node"
          output="screen">
    </node>

</launch>
