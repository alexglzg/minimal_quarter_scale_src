<launch>

	<include file="$(find gazebo_ros)/launch/empty_world.launch">
		<arg name="world_name" value="$(find gazebo_sim)/worlds/lake_world.world"/>
		<!-- <arg name="world_name" value="$(find gazebo_sim)/worlds/world_wow.world"/> -->
		<arg name="verbose" value="true" />
	</include>

	<arg name="use_sim_time" default="true" />
    
</launch>